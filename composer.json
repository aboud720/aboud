{
    "name": "aboud/store",
    "description": "متجر شحن ألعاب وتطبيقات احترافي",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "ABOUD Store Team",
            "email": "dev@aboud-store.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/",
            "Models\\": "models/",
            "Controllers\\": "controllers/",
            "Api\\": "api/",
            "Middleware\\": "middleware/",
            "Services\\": "services/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php database/migrate.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
