# ═══════════════════════════════════════════════════════════════════════════
# ABOUD STORE - Git Ignore
# ═══════════════════════════════════════════════════════════════════════════

# Environment
.env
.env.local
.env.*.local

# Storage (generated files)
storage/logs/*
storage/cache/*
storage/sessions/*
!storage/logs/.gitkeep
!storage/cache/.gitkeep
!storage/sessions/.gitkeep

# Uploads
public/uploads/*
!public/uploads/.gitkeep

# Dependencies
vendor/
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Compiled
*.map

# Debug
*.log
npm-debug.log*

# Testing
coverage/
.phpunit.result.cache

# Build
dist/
build/
